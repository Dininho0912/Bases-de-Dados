DROP TRIGGER IF EXISTS updatePartStock;
CREATE TRIGGER updatePartStock
AFTER INSERT ON RepairPart
FOR EACH ROW
BEGIN
   UPDATE PART
      SET availableQuantity = availableQuantity - NEW.Quantity
      WHERE Part.PartId = NEW.PartId;
END;

