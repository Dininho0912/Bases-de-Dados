CREATE TRIGGER validatePartRepair
BEFORE INSERT ON RepairPart
FOR EACH ROW 
WHEN NOT EXISTS(
   SELECT * FROM Repair
      JOIN Car USING (idCar)
      JOIN PartModel USING (modelId)
      JOIN Part USING (PartId)
   WHERE repairId = NEW.repairId
   AND partId = NEW.partId
   AND AvailableQuantity >= NEW.Quantity)
BEGIN
   SELECT RAISE (ABORT, "Invalid part or quantity");
END;

