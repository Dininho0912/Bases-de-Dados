CREATE VIEW ModelBrands
   AS SELECT Model.NAME AS ModelName,
      Brand.NAME AS BrandName
   FROM Model, Brand WHERE Model.BrandId = Brand.BrandId;

CREATE TRIGGER insertModelBrand
INSTEAD OF INSERT ON ModelBrands
FOR EACH ROW
BEGIN
   --the ignore is used if there is already that brand name or the model in a tupple
   INSERT OR IGNORE INTO Brand (name) VALUES (NEW.BrandName); 
   INSERT OR IGNORE INTO Model (name, BrandId) 
   SELECT NEW.modelName, brandId FROM Brand WHERE name = NEW.brandName;
END;
