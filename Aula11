CREATE TRIGGER defaultClient
AFTER INSERT ON Repair
FOR EACH ROW
WHEN (NEW.clientId is NULL)
BEGIN
   UPDATE Repair
      SET clientId = (SELECT clientId FROM car WHERE idCar = NEW.idCar)
      WHERE repairId = NEW.repairId;
END;

